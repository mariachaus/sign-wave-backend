{$DOMAIN::80} {
    encode gzip

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /ml/* {
        reverse_proxy backend:8000
    }

    handle /test_db {
        reverse_proxy backend:8000
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
